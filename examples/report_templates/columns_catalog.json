    {
      "id": "cols",
      "name": "Столбцы",
      "kind": "sql",
      "database": "",
      "sql": "SELECT t.name AS [Таблица], c.column_id AS [№], c.name AS [Столбец], ty.name AS [Тип],\n  CASE WHEN c.max_length = -1 THEN 'max' WHEN ty.name IN ('nvarchar','nchar') THEN CAST(c.max_length/2 AS varchar(10))\n       ELSE CAST(c.max_length AS varchar(10)) END AS [Длина],\n  CASE c.is_nullable WHEN 1 THEN N'Да' ELSE N'Нет' END AS [NULL], CASE c.is_identity WHEN 1 THEN N'Да' ELSE N'' END AS [Identity]\nFROM sys.columns c JOIN sys.tables t ON t.object_id = c.object_id JOIN sys.schemas s ON s.schema_id = t.schema_id\nJOIN sys.types ty ON ty.user_type_id = c.user_type_id\nWHERE t.is_ms_shipped = 0 AND s.name = :schema\nORDER BY t.name, c.column_id",
      "schema": "dbo",
