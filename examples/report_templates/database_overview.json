    {
      "id": "tables",
      "name": "Таблицы",
      "kind": "sql",
      "database": "",
      "sql": "SELECT s.name AS [Схема], t.name AS [Таблица], SUM(p.rows) AS [Строк], t.create_date AS [Создана]\nFROM sys.tables t\nJOIN sys.schemas s ON s.schema_id = t.schema_id\nJOIN sys.partitions p ON p.object_id = t.object_id AND p.index_id IN (0, 1)\nWHERE t.is_ms_shipped = 0\nGROUP BY s.name, t.name, t.create_date\nORDER BY SUM(p.rows) DESC",
      "schema": "dbo",
      "table": "",
      "columns": [],
      "filters": [],
      "order_by": [],
      "group_by": [],
      "aggregates": [],
      "row_limit": 0,
      "procedure": "",
      "proc_params": {},
      "proc_trusted": false
    },
    {
      "id": "objects",
      "name": "Объекты по типам",
      "kind": "sql",
      "database": "",
      "sql": "SELECT CASE type WHEN 'U' THEN N'Таблицы' WHEN 'V' THEN N'Представления' WHEN 'P' THEN N'Процедуры'\n  WHEN 'FN' THEN N'Скалярные функции' WHEN 'IF' THEN N'Табличные функции (inline)'\n  WHEN 'TF' THEN N'Табличные функции' WHEN 'TR' THEN N'Триггеры' END AS [Тип], COUNT(*) AS [Количество]\nFROM sys.objects WHERE is_ms_shipped = 0 AND type IN ('U','V','P','FN','IF','TF','TR')\nGROUP BY type ORDER BY COUNT(*) DESC",
      "schema": "dbo",
      "table": "",
      "columns": [],
      "filters": [],
      "order_by": [],
      "group_by": [],
      "aggregates": [],
      "row_limit": 0,
