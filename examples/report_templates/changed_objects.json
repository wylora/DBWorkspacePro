      "id": "chg",
      "name": "Изменённые объекты",
      "kind": "sql",
      "database": "",
      "sql": "SELECT o.type_desc AS [Тип], s.name AS [Схема], o.name AS [Объект], o.create_date AS [Создан], o.modify_date AS [Изменён]\nFROM sys.objects o JOIN sys.schemas s ON s.schema_id = o.schema_id\nWHERE o.is_ms_shipped = 0 AND o.type IN ('U','V','P','FN','IF','TF','TR')\n  AND (:date_from IS NULL OR o.modify_date >= :date_from)\n  AND (:date_to IS NULL OR o.modify_date < DATEADD(day, 1, :date_to))\nORDER BY o.modify_date DESC",
